# Copy to backend/.env (or .env in the repository root). Never commit real keys.
ATLAS_ENVIRONMENT=development
# Defaults to the private .atlas/ directory at the repository root.
# ATLAS_DATA_DIR=/absolute/private/atlas-data
# ATLAS_DATABASE_URL=sqlite:////absolute/private/atlas-data/workspace.db
ATLAS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ATLAS_REQUEST_LIMIT=60
# Optional. Empty keys do not prevent startup.
GROQ_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
# Production requires a unique owner token >= 24 characters. Use HTTPS.
# ATLAS_OWNER_TOKEN=
# Optional Fernet key. Otherwise generated once in ATLAS_DATA_DIR/master.key.
# ATLAS_MASTER_KEY=
